<Layouts.app flash={@flash} locale={@locale}>
  <div class="mx-auto max-w-md py-10">
    <div class="flex justify-center">
      <Layouts.hex_logo class="size-16" />
    </div>
    <h1 class="mt-6 text-center text-3xl font-bold tracking-tight">
      {gettext("Welcome to HexTank")}
    </h1>
    <p class="mt-3 text-center text-base-content/70">
      {gettext(
        "Tank Tactics on a hexagonal board. Earn action points over time, make alliances, betray them. Last tank standing wins."
      )}
    </p>

    <.form
      for={@form}
      id="welcome-form"
      action={~p"/players"}
      class="mt-8 rounded-2xl border border-base-300 bg-base-200/60 p-6 shadow-sm"
    >
      <input type="hidden" name="return_to" value={@return_to} />
      <.input
        field={@form[:nickname]}
        label={gettext("Pick a nickname")}
        placeholder={gettext("2 to 20 letters, digits, spaces")}
        autocomplete="off"
        maxlength="20"
        required
        autofocus
      />
      <button id="welcome-submit" class="btn btn-primary mt-2 w-full">
        {gettext("Let's play")}
      </button>
      <p class="mt-4 text-sm text-base-content/60">
        {gettext(
          "No account needed. Next you'll get a personal link to come back from any device."
        )}
      </p>
    </.form>
  </div>
</Layouts.app>
