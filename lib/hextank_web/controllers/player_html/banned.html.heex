<Layouts.app flash={@flash} locale={@locale}>
  <div id="banned" class="mx-auto max-w-md py-16 text-center">
    <.icon name="hero-no-symbol" class="size-14 text-error" />
    <h1 class="mt-4 text-2xl font-bold">{gettext("You've been banned")}</h1>
    <p class="mt-3 text-base-content/70">
      {gettext(
        "You wrote prohibited words three times. Your tanks are frozen and you can't play or chat anymore."
      )}
    </p>
  </div>
</Layouts.app>
