<Layouts.app flash={@flash} current_player={@current_player} locale={@locale}>
  <div id="dormant" class="mx-auto max-w-md py-16 text-center">
    <.icon name="hero-moon" class="size-12 text-primary" />
    <h1 class="mt-4 text-2xl">{gettext("You've been away")}</h1>
    <p class="mt-3 text-base-content/70">
      {gettext("We paused this page to save energy. Your tables keep going without you.")}
    </p>
    <.link id="dormant-back" href={~p"/"} class="btn btn-primary btn-lg mt-8">
      {gettext("Back to the lobby")}
    </.link>
  </div>
</Layouts.app>
